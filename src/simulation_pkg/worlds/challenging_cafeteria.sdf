<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="challenging_cafeteria">

    <!-- Sun -->
    <light type="directional" name="sun">
        <cast_shadows>true</cast_shadows>
        <pose>0 0 10 0 0 0</pose>
        <diffuse>0.8 0.8 0.8 1</diffuse>
        <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Ground (Scaled up for 30x20m room) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- === WALLS (Room Size: 30m x 20m) === -->
    
    <!-- LEFT WALL (POSTER AREA) - y = -10 -->
    <!-- This wall is kept clear for posters -->
    <model name="left_wall_poster_area">
      <static>true</static>
      <pose>0 -10 1 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>30 0.3 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>30 0.3 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- RIGHT WALL - y = 10 -->
    <model name="right_wall">
      <static>true</static>
      <pose>0 10 1 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>30 0.3 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>30 0.3 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- BACK WALL - x = -15 -->
    <model name="back_wall">
      <static>true</static>
      <pose>-15 0 1 0 0 1.57</pose>
      <link name="wall_link">
         <collision name="collision"><geometry><box><size>20 0.3 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20 0.3 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- FRONT WALL - x = 15 -->
    <model name="front_wall">
      <static>true</static>
      <pose>15 0 1 0 0 1.57</pose>
      <link name="wall_link">
         <collision name="collision"><geometry><box><size>20 0.3 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20 0.3 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- === TABLES GRID (Realism Update) === -->
    <!-- Layout: 6 Columns x 2 Rows -->
    <!-- Table Size: 1.5m (X) x 3.0m (Y) x 0.8m (Z) -->
    <!-- This represents large cafeteria "banquet" tables -->
    <!-- Columns X: -12, -7, -2, 3, 8, 13 -->
    <!-- Rows Y: 
         Row 1: y = 2.5 (Leaving wide corridor from y=-10 to y=0)
         Row 2: y = 7.0 
    -->

    <model name="table_row1_1">
      <static>true</static> <pose>-12 2.5 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>1.5 3.0 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 3.0 0.8</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual></link>
    </model>
    <model name="table_row1_2">
      <static>true</static> <pose>-7 2.5 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>1.5 3.0 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 3.0 0.8</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual></link>
    </model>
    <model name="table_row1_3">
      <static>true</static> <pose>-2 2.5 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>1.5 3.0 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 3.0 0.8</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual></link>
    </model>
    <model name="table_row1_4">
      <static>true</static> <pose>3 2.5 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>1.5 3.0 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 3.0 0.8</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual></link>
    </model>
    <model name="table_row1_5">
      <static>true</static> <pose>8 2.5 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>1.5 3.0 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 3.0 0.8</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual></link>
    </model>
    <model name="table_row1_6">
      <static>true</static> <pose>13 2.5 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>1.5 3.0 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 3.0 0.8</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual></link>
    </model>

    
    <model name="table_row2_1">
      <static>true</static> <pose>-12 7.0 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>1.5 3.0 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 3.0 0.8</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual></link>
    </model>
    <model name="table_row2_2">
      <static>true</static> <pose>-7 7.0 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>1.5 3.0 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 3.0 0.8</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual></link>
    </model>
    <model name="table_row2_3">
      <static>true</static> <pose>-2 7.0 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>1.5 3.0 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 3.0 0.8</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual></link>
    </model>
    <model name="table_row2_4">
      <static>true</static> <pose>3 7.0 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>1.5 3.0 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 3.0 0.8</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual></link>
    </model>
    <model name="table_row2_5">
      <static>true</static> <pose>8 7.0 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>1.5 3.0 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 3.0 0.8</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual></link>
    </model>
    <model name="table_row2_6">
      <static>true</static> <pose>13 7.0 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>1.5 3.0 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 3.0 0.8</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual></link>
    </model>

    <!-- === POSTERS (Distributed along Left Wall y=-10) === -->
    <!-- Facing the room (Yaw = 1.57) -->
    
    <!-- Cluster 1 (Left Side) -->
    <include>
      <uri>model://poster_board_1</uri>
      <name>noticeboard_1</name>
      <pose>-10 -9.6 1.25 0 0 1.57</pose>
    </include>
    <include>
      <uri>model://poster_board_2</uri>
      <name>noticeboard_2</name>
      <pose>-7 -9.6 1.25 0 0 1.57</pose>
    </include>

    <!-- Cluster 2 (Center-ish) -->
    <include>
      <uri>model://poster_board_3</uri>
      <name>noticeboard_3</name>
      <pose>-1 -9.6 1.25 0 0 1.57</pose>
    </include>
    <include>
      <uri>model://poster_board_4</uri>
      <name>noticeboard_4</name>
      <pose>2 -9.6 1.25 0 0 1.57</pose>
    </include>

    <!-- Cluster 3 (Right Side) -->
    <include>
      <uri>model://poster_board_5</uri>
      <name>noticeboard_5</name>
      <pose>9 -9.6 1.25 0 0 1.57</pose>
    </include>
    <include>
      <uri>model://poster_board_6</uri>
      <name>noticeboard_6</name>
      <pose>12 -9.6 1.25 0 0 1.57</pose>
    </include>

  </world>
</sdf>
